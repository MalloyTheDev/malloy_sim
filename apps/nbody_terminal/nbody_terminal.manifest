<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded in malloy_nbody_terminal (issue #33). It makes UTF-8 the process
  ANSI code page, so the narrow argv the CRT builds for main() and the narrow
  path std::ifstream opens both carry UTF-8, and a scenario path outside the
  system code page (Greek, CJK, emoji) opens. Honoured from Windows 10 1903;
  older systems ignore it and keep the system code page. The linker merges
  this with its own manifest (the asInvoker request) and embeds the result.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
